# QuickDrop environment configuration
# Copy to .env and adjust as needed. Never commit .env.

# Runtime
NODE_ENV=production
PORT=3000
# Bind address. 0.0.0.0 makes the server reachable on the LAN.
HOST=0.0.0.0

# Persistence (paths are relative to the working directory)
DATABASE_PATH=./data/app.db
STORAGE_PATH=./storage

# Upload limits
MAX_FILE_SIZE_MB=2048
MAX_FILES_PER_TRANSFER=20
MAX_TEXT_LENGTH_KB=512

# Transfer lifetime
TRANSFER_EXPIRATION_MINUTES=60

# Cleanup sweep interval
CLEANUP_INTERVAL_MS=60000

# Rate limiting (applies to transfer API endpoints)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=30

# Number of trusted reverse-proxy hops in front of the app (0 = none).
# Set to 1 when running behind nginx/Caddy so rate limiting sees the
# real client IP instead of the proxy's.
TRUST_PROXY=0

# Logging: debug | info | warn | error
LOG_LEVEL=info
