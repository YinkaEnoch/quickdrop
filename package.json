{
  "name": "quickdrop",
  "version": "1.0.0",
  "license": "ISC",
  "description": "Ephemeral, single-use file and text transfers between devices. No accounts, no durable storage.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.tests.json",
    "test": "node --import tsx --test \"tests/**/*.test.ts\"",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@types/adm-zip": "0.5.8",
    "@types/archiver": "8.0.0",
    "@types/ejs": "3.1.5",
    "@types/express": "5.0.6",
    "@types/multer": "2.3.0",
    "@types/node": "22.20.5",
    "adm-zip": "0.6.1",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "archiver": "8.0.0",
    "ejs": "7.0.1",
    "express": "5.2.1",
    "multer": "2.4.0"
  },
  "volta": {
    "node": "22.22.3"
  }
}
